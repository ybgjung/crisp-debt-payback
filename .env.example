# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> Data API  (URL)
#   Dashboard -> Project Settings -> API Keys  (anon / publishable key)
#
# The anon key is meant to be public and safe to ship in a browser bundle; every
# table is protected by row-level security. Never put the service_role key here.
#
# .env.local is git-ignored via the existing "*.local" rule.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
